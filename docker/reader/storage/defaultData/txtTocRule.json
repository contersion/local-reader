[
    {
        "id": -1,
        "enable": false,
        "name": "冒号分割",
        "rule": ".*(?<=[:：])\\s([\\u4e00-\\u9fa5a-zA-Z0-9]{1,7})[^\\n]{1,35}(?:\\n)?",
        "serialNumber": 1
    },
    {
        "id": -2,
        "enable": true,
        "name": "冒号分割 高级",
        "rule": "^任务[一二三四五六七八九十百千万\\d]+(?:\\([上下左右前中后本]\\))?[:：][^：]+[:：]第[一二三四五六七八九十百千万\\d]+章[:：].+$|^第[一二三四五六七八九十百千万\\d]+卷[：:\\s]+\\d+\\..+$|^第[一二三四五六七八九十百千万\\d]+章[：:\\s].+$|^第[一二三四五六七八九十百千万\\d]+卷·[^：]+?：第[一二三四五六七八九十百千万\\d]+章·.+$",
        "serialNumber": 2
    },
    {
        "id": -3,
        "enable": true,
        "name": "冒号分割3",
        "rule": "^\\s*([^：\\n]{2,})：(?:番外|特别篇)?第([一二三四五六七八九十百千万零]{1,6})章\\s+([^【】:：，。！？；\\n]{4,50})\\s*$",
        "serialNumber": 3
    },
    {
        "id": -4,
        "enable": true,
        "name": "保底规则",
        "rule": "^\\s{0,4}第(?:\\d+|[〇零一二两三四五六七八九十百千万壹贰叁肆伍陆柒捌玖拾佰仟]{1,12})章(?:[：:、.·_\\-\\s]{0,3}[^\\n，。！？；：“”\"'（）()]{1,30})?$",
        "serialNumber": 4
    }
]
